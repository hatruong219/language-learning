NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_ID=

# Groq — chấm bài viết tự động + nhận diện giọng nói của Kotoba (/kotoba-app/api/stt, Whisper)
# Route STT công khai: nên đặt hạn mức chi tiêu (spend cap) trên tài khoản Groq
# Lấy API key tại: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant

# Kanji mỗi ngày — Web Push tới app "Kanji" trên Màn hình chính (/api/kanji/push)
# Tạo cặp khoá: pnpm exec web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Mã đăng ký lấy từ nút "Bật thông báo" trong app (JSON; mảng nếu nhiều máy)
PUSH_SUBSCRIPTION=
SITE_URL=https://study.truongha.com
# Chuỗi ngẫu nhiên; Vercel Cron tự gửi kèm header Authorization
CRON_SECRET=
